# Desenvolvimento local. Em produção o .env da raiz do repositório é a fonte (docker-compose.yml).
DATABASE_URL=postgresql://gastos:gastos@localhost:5433/gastos?schema=public
# Só para `pnpm db:migrate` em dev local (banco-sombra da Prisma) — precisa de CREATEDB, por isso usa o
# superusuário do docker-compose.dev.yml, nunca o papel `gastos`. Ausente em produção (lá só migrate deploy).
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres?schema=public
PORT=3001
NODE_ENV=development
# 32+ caracteres. Em produção: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-session-secret-0123456789
# Sessão vale 30 dias sem uso (janela deslizante) — docs/specs/08-seguranca.md § 4
SESSION_IDLE_DAYS=30
# Só exigida em produção (64 hex, AES-256-GCM): openssl rand -hex 32
# DATA_ENCRYPTION_KEY=
# Rate limit fica ligado por padrão em todo ambiente (08-seguranca § 5). Só em dev local
# se desliga, para sessões repetidas de teste não travarem em 429. Nunca 'false' em produção.
RATE_LIMIT_ENABLED=false
# Credenciais do painel do Pluggy (nunca cole num chat — se vazar, gere novas no painel e troque aqui).
# Sem elas, o PluggyClient recusa chamadas com PLUGGY_NOT_CONFIGURED em vez de travar o boot da API.
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# E-mail (esqueci minha senha). 'log' só escreve o link no console da API — padrão em dev e testes. Em
# produção use 'smtp' com um provedor de verdade e preencha os campos abaixo (nunca cole a senha num chat).
MAIL_TRANSPORT=log
# MAIL_HOST=
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_AUTH_USER=
# MAIL_AUTH_PASS=
# MAIL_FROM="AbacaTudo <no-reply@seudominio.com>"
# Base do link de reset enviado por e-mail. Em produção o docker-compose.yml já passa isso.
WEB_ORIGIN=http://localhost:3000
